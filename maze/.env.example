# Copy this file to .env, or save your key through Configure agent.
# Keep .env private. Never include real API keys in a release.
# Pick a provider: openai, anthropic, google, xai, openrouter or custom.
MAZE_AGENT_PROVIDER=openai
MAZE_AGENT_MODEL=gpt-4o-mini
MAZE_AGENT_MAX_STEPS=2000
# Each provider reads its own key, so you can keep several saved at once.
MAZE_AGENT_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# MAZE_AGENT_BASE_URL=https://your-provider.example/v1
# MAZE_PORT=5000          # port for the web app
# MAZE_NO_BROWSER=1      # set to stop web_app.py opening your browser
