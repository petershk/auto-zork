# Copy this file to .env, or save your key through Configure agent.
# Keep .env private. Never include real API keys in a release.
# Pick a provider: openai, anthropic, google, xai, openrouter or custom.
MAZE_AGENT_PROVIDER=openai
MAZE_AGENT_MODEL=gpt-4o-mini
MAZE_AGENT_MAX_STEPS=2000
# Each provider reads its own key, so you can keep several saved at once.
MAZE_AGENT_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# MAZE_AGENT_BASE_URL=https://your-provider.example/v1
# MAZE_PORT=5000          # port for the web app
# MAZE_NO_BROWSER=1      # set to stop web_app.py opening your browser

# Video (maze/video). FAL_KEY pays for image and video generation; never commit it.
# FAL_KEY=
# VIDEO_ROOMS=Forest And Outside Of House,House   # engine room ids or area names to film; empty films every room
# IMAGE_MODEL=nano-banana-pro
# VIDEO_MODEL=seedance-2.0        # seedance-2.0 | kling-3.0 | ltx-2.3
# LLM_PROVIDER=anthropic          # writes the prompts, with that provider's key above
# LLM_MODEL=claude-haiku-5-5
# MAX_SPEND_USD=100               # image and video scripts stop before the running total would pass this
# VIDEO_PRICE_PER_SECOND=         # overrides the built-in price for VIDEO_MODEL
# CLIP_CONCURRENCY=3
# SPECULATION_CONCURRENCY=2
# SEAM_THRESHOLD=0.85
# VIDEO_ASSET_URL=https://pub-0bd051fddf4c41f19f7ecf337545922b.r2.dev   # where pictures and clips not on disk come from
